return {
  name           = "dbus",
  version        = "1.16.2",
  summary        = "D-Bus message bus system",
  url            = "https://dbus.freedesktop.org/releases/dbus/dbus-1.16.2.tar.xz",
  sha256         = nil,
  deps           = { "audit" },
  build_system   = "meson",
  archive_format = "xz",
  configure_args = {
    "-Dinstalled_tests=false",
    "-Dmodular_tests=disabled",
    "-Dsystemd_system_unitdir=no",
    "-Dsystemd_user_unitdir=no",
    "-Dsession_socket_dir=/tmp",
    "-Dsystem_socket=/run/dbus/system_bus_socket",
    "-Ddbus_user=messagebus",
    "-Ddbus_daemondir=/usr/bin",
    "-Dxml_docs=disabled",
    "-Ddoxygen_docs=disabled",
    "-Dducktype_docs=disabled",
    "-Dqt_help=disabled",
    "-Dvalgrind=disabled",
  },
  test = "test -x ${DESTDIR}/usr/bin/dbus-daemon && test -e ${DESTDIR}/usr/lib/libdbus-1.so",
}
